        "id": "477b0f5e-dae0-4604-9f0c-a69bef57ffe0",
        "name": "CheckPrimaryError"
      },
      {
        "parameters": {
          "jsCode": "const output = [];\n\nfor (const item of $input.all()) {\n  const data = item.json;\n  const dateString = data.date;\n  \n  // Dynamically find any key that represents our base currency (ignoring metadata keys like 'date')\n  const baseCurrencyKey = Object.keys(data).find(key => key !== 'date');\n  \n  if (baseCurrencyKey && data[baseCurrencyKey]) {\n    const exchangeRatesObj = data[baseCurrencyKey];\n    \n    for (const targetCurrency in exchangeRatesObj) {\n      if (exchangeRatesObj.hasOwnProperty(targetCurrency)) {\n        const rateValue = exchangeRatesObj[targetCurrency];\n        \n        // Dynamically clean out null/missing values to prevent database inserts of incomplete data\n        if (rateValue !== null && rateValue !== undefined) {\n          output.push({\n            json: {\n              date: dateString,\n              base_currency: baseCurrencyKey.toUpperCase(),\n              target_currency: targetCurrency.toUpperCase(),\n              rate: Number(rateValue)\n            }\n          });\n        }\n      }\n    }\n  }\n}\n\nreturn output;\n"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
