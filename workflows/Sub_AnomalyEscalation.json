        "parameters": {
          "jsCode": "const record = $input.item.json || {};\n\n// Extract transaction fields with safe fallbacks\nconst transactionId = record.transaction_id || 'N/A';\nconst region = record.region || 'N/A';\nconst revenue = Number(record.revenue ?? 0);\nconst batchMean = Number(record.batch_mean_revenue ?? 0);\nconst zScore = Number(record.z_score ?? 0);\nconst timestamp = record.timestamp || 'N/A';\n\n// Extract AI Analysis & Ticket fields\nconst rootCause = record.root_cause_hypothesis || 'Pending AI Analysis';\nconst recommendedAction = record.recommended_action || 'Review operational logs';\nconst issueUrl = record.issue_url || 'N/A';\n\n// Construct formatted alert message\nconst alertText = `\ud83d\udea8 *Data Anomaly & AI Analysis Report*\n\u2022 *Transaction ID*: ${transactionId}\n\u2022 *Region*: ${region}\n\u2022 *Revenue*: $${revenue.toLocaleString()} (Batch Mean: $${batchMean.toLocaleString()}, Z-Score: ${zScore})\n\u2022 *Timestamp*: ${timestamp}\n\u2022 *AI Hypothesis*: ${rootCause}\n\u2022 *Recommended Action*: ${recommendedAction}\n\u2022 *Incident Ticket*: ${issueUrl}`;\n\nreturn {\n  json: {\n    alert_text: alertText,\n    severity: Math.abs(zScore) > 3.0 ? 'CRITICAL' : 'WARNING'\n  }\n};"
        },
