      },
      {
        "parameters": {
          "jsCode": "const newItems = [];\n\n// Fetch incoming items using n8n's native JavaScript accessor\nfor (const item of $input.all()) {\n    const payloadData = item.json.body?.data || [];\n    \n    for (const tx of payloadData) {\n        let rawDate = tx.date || \"\";\n        let cleanDate = rawDate;\n        \n        // Standardize date to YYYY-MM-DD using regex\n        if (rawDate.match(/^\\d{2}-\\d{2}-\\d{4}$/)) {\n            cleanDate = rawDate.replace(/(\\d{2})-(\\d{2})-(\\d{4})/, '$3-$1-$2');\n        } else if (rawDate.match(/^\\d{4}\\/\\d{2}\\/\\d{2}$/)) {\n            cleanDate = rawDate.replace(/\\//g, '-');\n        } else if (rawDate.match(/^\\d{2}-\\d{2}-\\d{2}$/)) {\n            cleanDate = rawDate.replace(/(\\d{2})-(\\d{2})-(\\d{2})/, '20$3-$1-$2');\n        }\n            \n        // Flatten the dictionary to match PostgreSQL columns\n        const flatTx = {\n            tx_id: tx.id,\n            amount: tx.amount,\n            currency: tx.details?.currency,\n            status: tx.details?.status,\n            transaction_date: cleanDate\n        };\n        \n        // Append as a new n8n item\n        newItems.push({ json: flatTx });\n    }\n}\n\nreturn newItems;\n"
        },
        "type": "n8n-nodes-base.code",
