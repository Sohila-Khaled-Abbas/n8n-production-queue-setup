      {
        "parameters": {
          "jsCode": "const html = $json.html || \"\";\n\nconst title = html.match(/<h1>(.*?)<\\/h1>/i)?.[1] || \"\";\n\nlet emailBody = html\n  .replace(/<br\\s*\\/?>/gi, \"\\n\")\n  .replace(/<\\/p>/gi, \"\\n\")\n  .replace(/<\\/h1>/gi, \"\\n\")\n  .replace(/<\\/h2>/gi, \"\\n\")\n  .replace(/<li>/gi, \"\u2022 \")\n  .replace(/<\\/li>/gi, \"\\n\")\n  .replace(/<[^>]+>/g, \"\")\n  .replace(/&nbsp;/g, \" \")\n  .replace(/&amp;/g, \"&\")\n  .replace(/\\r/g, \"\")\n  .replace(/[ \\t]+\\n/g, \"\\n\")\n  .replace(/\\n[ \\t]+/g, \"\\n\")\n  .replace(/\\n{2,}/g, \"\\n\")\n  .trim();\n\nreturn [{\n  json: {\n    Date: new Date().toISOString(),\n    Title: title,\n    EmailBody: emailBody\n  }\n}];"
        },
