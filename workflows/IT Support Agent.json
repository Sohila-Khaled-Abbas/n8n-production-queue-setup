          "messages": {
            "values": [
              {
                "content": "=You are the IT Support Team\u2019s coordinator. Your task is to collect incoming information about new support tickets and produce a concise summary to email to the IT management. The email should be signed with \u201cIT Support Team.\u201d\nHere are the details of the support tickets:\nTicket ID: {{ $json.fields['Ticket ID'] }}\nUser: {{ $json.fields.User }}\nIssue: {{ $json.fields.Issue }}\nPriority: {{ $json.fields.Priority }}\nDate Submitted: {{ $json.fields['Date Submitted'] }}\nStatus: {{ $json.fields.Status }}\nPlease provide the following output parameters:\nEmail_subject\nEmail_content\nMake the content clean and with bullet points"
              }
            ]
          },
          "builtInTools": {},
          "options": {}
        },
