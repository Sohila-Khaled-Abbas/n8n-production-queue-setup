      {
        "parameters": {
          "jsonSchemaExample": "{\n  \"company_name\": \"The official name of the competitor analyzed.\",\n  \"pricing_url\": \"The absolute URL where the pricing or enterprise tier details were extracted.\",\n  \"enterprise_tier_exists\": \"A boolean (true/false) indicating if a custom Enterprise, Corporate, or highest-tier plan exists.\",\n  \"starting_price\": \"The starting price of the Enterprise plan if listed (e.g., '$2,500/yr'). If pricing is custom, unlisted, or requires a demo, output 'Contact Sales'.\",\n  \"key_enterprise_features\": [\n    \"A list of distinct features or add-ons exclusive to this tier (e.g., SSO, 99.9% SLA, dedicated technical account manager).\"\n  ],\n  \"limitations_and_constraints\": \"Any contract minimums, seat requirements, API rate limits, or usage caps tied to this plan. If none are specified, output 'None specified'.\"\n}"
        },
