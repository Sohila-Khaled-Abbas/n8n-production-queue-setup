      {
        "parameters": {
          "operation": "sendAndWait",
          "sendTo": "sohila.k.data@gmail.com",
          "subject": "=Action Required: Competitive Profile Review - \" + {{$json.output.company_name}}",
          "message": "=<p>A new competitor profile has been compiled by the <strong>Autonomous Research Agent</strong> and is awaiting validation.</p>\n\n<hr>\n\n<ul>\n  <li><strong>Competitor Name:</strong> {{$json.output.company_name || 'N/A'}}</li>\n  <li><strong>Pricing URL:</strong> <a href=\"{{$json.output.pricing_url || '#'}}\">Verify pricing page</a></li>\n  <li><strong>Enterprise Tier Identified:</strong> {{($json.output.enterprise_tier_exists && $json.output.enterprise_tier_exists.toLowerCase() === 'yes') ? 'Yes \u2705' : 'No \u274c'}}</li>\n  <li><strong>Starting Price:</strong> <strong>{{$json.starting_price || 'Unknown'}}</strong></li>\n</ul>\n\n<h3>\ud83c\udf1f Extracted Enterprise Features:</h3>\n<ul>\n  {{ Array.isArray($json.output.key_enterprise_features) && $json.output.key_enterprise_features.length > 0 ? $json.output.key_enterprise_features.map(feature => `<li>${feature}</li>`).join('') : '<li>No features extracted or data format error.</li>' }}\n</ul>\n\n<h3>\u26a0\ufe0f Limitations & Constraints:</h3>\n<p><em>{{$json.output.limitations_and_constraints || 'None provided.'}}</em></p>",
          "approvalOptions": {
            "values": {
              "approvalType": "double"
            }
          },
