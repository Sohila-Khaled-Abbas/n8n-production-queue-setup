      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "// 1. Get raw text from the AI node output\nconst rawText = $input.item.json.text || '';\n\n// 2. Strip markdown code fence blocks (```json ... ```)\nconst cleanedText = rawText\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\n// 3. Parse JSON safely with fallbacks\nlet aiData = {};\ntry {\n  aiData = JSON.parse(cleanedText);\n} catch (e) {\n  aiData = {\n    severity_assessment: \"WARNING\",\n    root_cause_hypothesis: rawText || \"Unable to parse AI response as JSON.\",\n    recommended_action: \"Inspect transaction logs manually.\"\n  };\n}\n\n// 4. Retrieve original transaction context from CheckForAnomalies\nconst anomalyRecord = $('CheckForAnomalies').item.json || {};\n\nconst severity = aiData.severity_assessment || 'CRITICAL';\nconst hypothesis = aiData.root_cause_hypothesis || 'N/A';\nconst action = aiData.recommended_action || 'N/A';\n\n// 5. Output unified payload ready for Jira\nreturn {\n  json: {\n    // Transaction Fields\n    transaction_id: anomalyRecord.transaction_id || 'N/A',\n    region: anomalyRecord.region || 'N/A',\n    revenue: anomalyRecord.revenue || 0,\n    z_score: anomalyRecord.z_score || 0,\n    timestamp: anomalyRecord.timestamp || 'N/A',\n    \n    // Parsed AI Fields\n    severity_assessment: severity,\n    root_cause_hypothesis: hypothesis,\n    recommended_action: action,\n    \n    // Pre-formatted Jira Ticket Fields\n    jira_summary: `[${severity}] Data Anomaly Detected: TX ${anomalyRecord.transaction_id} (${anomalyRecord.region})`,\n    jira_description: `An anomaly was flagged by the statistical pipeline.\n\n\u2022 Transaction ID: ${anomalyRecord.transaction_id}\n\u2022 Region: ${anomalyRecord.region}\n\u2022 Revenue: $${anomalyRecord.revenue}\n\u2022 Z-Score: ${anomalyRecord.z_score}\n\u2022 Timestamp: ${anomalyRecord.timestamp}\n\n--- AI Root Cause Analysis ---\n\u2022 Severity: ${severity}\n\u2022 Hypothesis: ${hypothesis}\n\u2022 Recommended Action: ${action}`\n  }\n};"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1888,
          -192
        ],
        "id": "c011abb4-7d8c-4dee-8199-4cbe8e9b35a9",
