      {
        "parameters": {
          "jsCode": "// Validate schema and sanitize nulls / numeric types\nconst items = $input.all();\nconst cleanedData = [];\n\nfor (const item of items) {\n  const record = item.json;\n  \n  // Mandatory field check\n  if (!record.transaction_id || !record.timestamp) {\n    continue;\n  }\n  \n  cleanedData.push({\n    json: {\n      transaction_id: String(record.transaction_id).trim(),\n      timestamp: new Date(record.timestamp).toISOString(),\n      region: record.region ? String(record.region).toUpperCase() : 'UNKNOWN',\n      revenue: parseFloat(record.revenue) || 0.0,\n      conversion_rate: parseFloat(record.conversion_rate) || 0.0,\n      latency_ms: parseInt(record.latency_ms, 10) || 0\n    }\n  });\n}\n\nreturn cleanedData;"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          640,
          -64
        ],
        "id": "0af734c0-972c-479c-bd29-71db312ca1ca",
        "name": "CleanAndValidateSchema"
      },
      {
        "parameters": {
          "jsCode": "// Compute sample mean, standard deviation, and Z-Score for revenue metric\nconst items = $input.all();\nconst revenues = items.map(item => item.json.revenue);\n\nif (revenues.length === 0) return [];\n\n// Calculate Mean\nconst mean = revenues.reduce((acc, val) => acc + val, 0) / revenues.length;\n\n// Calculate Standard Deviation\nconst variance = revenues.reduce((acc, val) => acc + Math.pow(val - mean, 2), 0) / revenues.length;\nconst stdDev = Math.sqrt(variance);\n\n// Z-Score threshold for anomaly detection (2.0 = ~95.4% confidence interval)\nconst ANOMALY_THRESHOLD = 2.0;\n\nreturn items.map(item => {\n  const rev = item.json.revenue;\n  const zScore = stdDev === 0 ? 0 : (rev - mean) / stdDev;\n  const isAnomaly = Math.abs(zScore) >= ANOMALY_THRESHOLD;\n  \n  return {\n    json: {\n      ...item.json,\n      batch_mean_revenue: Number(mean.toFixed(2)),\n      batch_std_dev: Number(stdDev.toFixed(2)),\n      z_score: Number(zScore.toFixed(4)),\n      is_anomaly: isAnomaly\n    }\n  };\n});"
        },
        "type": "n8n-nodes-base.code",
