          "jsCode": "// Merge Jira ticket output with the formatted AI & Transaction data\nconst jiraOutput = $input.item.json || {};\nconst aiAndTxData = $('FormatAIResponseForJira').item.json || {};\n\nreturn {\n  json: {\n    ...aiAndTxData,\n    issue_url: jiraOutput.key || jiraOutput.self || jiraOutput.issue_url || 'N/A'\n  }\n};"
