        "parameters": {
          "jsCode": "// 1. Retrieve all cleaned records from the ETL stage\nconst allCleanItems = $('CleanAndValidateSchema').all().map(item => item.json);\nconst jsonContent = JSON.stringify(allCleanItems, null, 2);\n\n// 2. Generate partition dates (year=YYYY/month=MM)\nconst now = new Date();\nconst year = now.getFullYear();\nconst month = String(now.getMonth() + 1).padStart(2, '0');\nconst timestamp = now.getTime();\n\nconst fileKey = `year=${year}/month=${month}/batch_${timestamp}.json`;\nconst fileName = `batch_${timestamp}.json`;\n\n// 3. Convert JSON text into n8n binary data buffer\nconst binaryData = await this.helpers.prepareBinaryData(\n  Buffer.from(jsonContent),\n  fileName,\n  'application/json'\n);\n\nreturn [\n  {\n    json: {\n      file_key: fileKey,\n      file_name: fileName,\n      total_archived_records: allCleanItems.length,\n      archived_at: now.toISOString()\n    },\n    binary: {\n      data: binaryData\n    }\n  }\n];"
        },
