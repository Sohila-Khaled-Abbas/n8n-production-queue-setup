      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "CREATE TABLE IF NOT EXISTS customers (\n    stripe_customer_id VARCHAR(255) PRIMARY KEY,\n    email VARCHAR(255),\n    name VARCHAR(255),\n    phone VARCHAR(50),\n    delinquent BOOLEAN DEFAULT FALSE,\n    user_id VARCHAR(255),\n    last_event_id VARCHAR(255),\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);",
          "options": {}
        },
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
