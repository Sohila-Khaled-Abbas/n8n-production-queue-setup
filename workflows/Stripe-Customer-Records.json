      {
        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO customers (\n    stripe_customer_id,\n    email,\n    name,\n    phone,\n    delinquent,\n    user_id,\n    last_event_id,\n    updated_at\n) VALUES (\n    '{{ $('TransformCustomerData').item.json.stripe_customer_id }}',\n    '{{ $('TransformCustomerData').item.json.email }}',\n    '{{ $('TransformCustomerData').item.json.name }}',\n    '{{ $('TransformCustomerData').item.json.phone }}',\n   {{ $('TransformCustomerData').item.json.delinquent }} ,\n    '{{ $('TransformCustomerData').item.json.user_id }}',\n    '{{ $('TransformCustomerData').item.json.last_event_id }}',\n    '{{ $('TransformCustomerData').item.json.updated_at }}'\n)\nON CONFLICT (stripe_customer_id)\nDO UPDATE SET\n    email = EXCLUDED.email,\n    name = EXCLUDED.name,\n    phone = EXCLUDED.phone,\n    delinquent = EXCLUDED.delinquent,\n    user_id = EXCLUDED.user_id,\n    last_event_id = EXCLUDED.last_event_id,\n    updated_at = EXCLUDED.updated_at;",
          "options": {}
