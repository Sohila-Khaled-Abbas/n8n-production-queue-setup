      },
      {
        "parameters": {
          "jsCode": "const body = $input.first().json.body;\nconst customer = body.data.object;\n\n// Sanitize single quotes for raw SQL safety if needed\nconst cleanString = (val) => val ? String(val).replace(/'/g, \"''\") : null;\n\nreturn [\n  {\n    json: {\n      stripe_customer_id: customer.id,\n      email: cleanString(customer.email),\n      name: cleanString(customer.name),\n      phone: cleanString(customer.phone),\n      delinquent: Boolean(customer.delinquent),\n      user_id: cleanString(customer.metadata?.user_id),\n      last_event_id: body.id,\n      updated_at: new Date(body.created * 1000).toISOString()\n    }\n  }\n];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          672,
          -176
        ],
