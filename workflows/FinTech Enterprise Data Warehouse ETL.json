            "id": "5617978f-0b85-4382-8768-f84e14ee6223",
            "name": "PostgreSQL \u2014 n8n Stack"
          }
        }
      },
      {
        "parameters": {
          "language": "pythonNative",
          "pythonCode": "from dateutil import parser\nimport datetime\n\noutput_items = []\n# Grab the array of settlements from the first incoming webhook item\nsettlements = items['json']['settlements']\n\nfor trx in settlements:\n    # Standardize the messy date strings to ISO format (YYYY-MM-DD)\n    parsed_date = parser.parse(trx[\"date\"])\n    clean_date = parsed_date.strftime('%Y-%m-%d')\n    \n    # Flatten the nested customer object\n    flat_item = {\n        \"transaction_id\": trx[\"trx_id\"],\n        \"amount\": trx[\"amount\"],\n        \"settlement_date\": clean_date,\n        \"customer_id\": trx[\"customer\"][\"id\"],\n        \"customer_name\": trx[\"customer\"][\"name\"]\n    }\n    \n    # Append each transaction as its own n8n item\n    output_items.append({\"json\": flat_item})\n\n# Returns 5 separate items to the pipeline\nreturn output_items\n"
        },
