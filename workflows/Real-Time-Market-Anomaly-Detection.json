      {
        "parameters": {
          "jsCode": "const inputData = $input.first().json;\n\n// 1. Trap API errors or unexpected structures\nif (!inputData.prices || !Array.isArray(inputData.prices) || inputData.prices.length === 0) {\n  return [{\n    json: {\n      error_detected: true,\n      anomaly_detected: false,\n      message: inputData.status?.error_message || 'Invalid or empty price dataset returned.'\n    }\n  }];\n}\n\nconst pricesArr = inputData.prices; // Array of [timestamp_ms, price]\n\nif (pricesArr.length < 2) {\n  return [{\n    json: {\n      error_detected: true,\n      anomaly_detected: false,\n      message: 'Insufficient historical data points available.'\n    }\n  }];\n}\n\n// 2. Extract latest price and enforce numeric float types\nconst latestEntry = pricesArr[pricesArr.length - 1];\nconst currentPrice = parseFloat(latestEntry[1]);\n\n// 3. Compute 24-hour moving average across returned hourly intervals\nlet sumPrice = 0;\nfor (let i = 0; i < pricesArr.length; i++) {\n  sumPrice += parseFloat(pricesArr[i][1]);\n}\nconst movingAverage24h = sumPrice / pricesArr.length;\n\n// 4. Calculate percentage deviation\nconst deviationPct = ((currentPrice - movingAverage24h) / movingAverage24h) * 100;\nconst absDeviationPct = Math.abs(deviationPct);\n\n// 5. Evaluate against 5.0% threshold\nconst anomalyDetected = absDeviationPct >= 5.0;\nconst timestampISO = new Date(latestEntry[0]).toISOString();\n\nreturn [{\n  json: {\n    error_detected: false,\n    asset: 'Bitcoin (BTC)',\n    symbol: 'BTCUSD',\n    current_price: Number(currentPrice.toFixed(2)),\n    moving_average_24h: Number(movingAverage24h.toFixed(2)),\n    deviation_pct: Number(deviationPct.toFixed(2)),\n    abs_deviation_pct: Number(absDeviationPct.toFixed(2)),\n    anomaly_detected: anomalyDetected,\n    timestamp: timestampISO\n  }\n}];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
