      },
      {
        "parameters": {
          "jsCode": "// Loop over all incoming split items and dynamically flatten nested fields\nconst cleanedItems = [];\n\nfor (const item of $input.all()) {\n  const flatObj = {};\n  \n  // Recurse dynamically through nested objects without hardcoding key names\n  function flatten(obj, prefix = '') {\n    for (const key in obj) {\n      if (obj.hasOwnProperty(key)) {\n        const val = obj[key];\n        // Clean column names to comply with database conventions (lowercase, underscores)\n        const cleanKey = key.toLowerCase().replace(/[^a-z0-9_]/g, '_');\n        const propName = prefix ? `${prefix}_${cleanKey}` : cleanKey;\n        \n        if (val && typeof val === 'object' && !Array.isArray(val) && !(val instanceof Date)) {\n          flatten(val, propName);\n        } else {\n          flatObj[propName] = val;\n        }\n      }\n    }\n  }\n\n  flatten(item.json);\n  cleanedItems.push({ json: flatObj });\n}\n\nreturn cleanedItems;"
        },
