    {
      "parameters": {
        "name": "check_order_eligibility",
        "description": "Check if an order is eligible for cancellation. Input: order_id (number). Returns eligibility status and duration details.",
        "jsCode": "const orderId = args.order_id;\nconst supabaseUrl = '{{ $credentials.supabaseApi.apiUrl }}';\nconst supabaseKey = '{{ $credentials.supabaseApi.apiKey }}';\n\nconst response = await fetch(`${supabaseUrl}/rest/v1/orders?order_id=eq.${orderId}`, {\n  headers: {\n    'apikey': supabaseKey,\n    'Authorization': `Bearer ${supabaseKey}`\n  }\n});\nconst data = await response.json();\nif (data.length === 0) {\n  return JSON.stringify({ eligible: false, reason: \"Order not found\" });\n}\nconst order = data[0];\nconst startedAt = new Date(order.created_at || order.startedAt);\nconst ageInMinutes = (new Date() - startedAt) / 60000;\nconst eligible = ageInMinutes < 5 && (order.status === 'Pending' || order.status === 'Draft');\n\nreturn JSON.stringify({\n  eligible,\n  age_minutes: Math.round(ageInMinutes),\n  status: order.status,\n  order_id: orderId,\n  customer_chat_id: order.customer_chat_id\n});"
      },
      "type": "@n8n/n8n-nodes-langchain.tool",
      "typeVersion": 1,
      "position": [
        3400,
        380
      ],
      "id": "tool-check-eligibility",
      "name": "check_order_eligibility",
      "credentials": {
        "supabaseApi": {
          "id": "DndUTCcCP3GzfG5V",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "name": "cancel_order",
        "description": "Cancels an eligible order in the database. Input: order_id (number). Returns cancellation confirmation.",
        "jsCode": "const orderId = args.order_id;\nconst supabaseUrl = '{{ $credentials.supabaseApi.apiUrl }}';\nconst supabaseKey = '{{ $credentials.supabaseApi.apiKey }}';\n\nconst response = await fetch(`${supabaseUrl}/rest/v1/orders?order_id=eq.${orderId}`, {\n  method: 'PATCH',\n  headers: {\n    'apikey': supabaseKey,\n    'Authorization': `Bearer ${supabaseKey}`,\n    'Content-Type': 'application/json',\n    'Prefer': 'return=representation'\n  },\n  body: JSON.stringify({ status: 'Cancelled' })\n});\nconst data = await response.json();\nif (data.length === 0) {\n  return JSON.stringify({ success: false, reason: \"Order update failed\" });\n}\nreturn JSON.stringify({ success: true, order_id: orderId, status: 'Cancelled' });"
      },
      "type": "@n8n/n8n-nodes-langchain.tool",
      "typeVersion": 1,
      "position": [
