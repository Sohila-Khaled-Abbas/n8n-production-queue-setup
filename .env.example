# ============================================================
# Environment Configuration — TEMPLATE
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ─── Public Access ───────────────────────────────────────────
# The publicly reachable URL of your n8n instance (e.g. via ngrok or a reverse proxy)
N8N_EDITOR_BASE_URL=https://your-domain.example.com
WEBHOOK_URL=https://your-domain.example.com

# ─── Release / Runtime ───────────────────────────────────────
NODE_ENV=production
N8N_RELEASE_TYPE=stable

# ─── Feature Flags ───────────────────────────────────────────
N8N_COMMUNITY_PACKAGES_ALLOW_TOOL_USAGE=true
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
N8N_SKIP_AUTH_ON_OAUTH_CALLBACK=true

# ─── Encryption Key ──────────────────────────────────────────
# ⚠️  CRITICAL — Set this BEFORE first launch and NEVER change it.
# n8n uses this key to AES-256-CBC encrypt all credentials stored in PostgreSQL.
# If this is missing, n8n auto-generates a random key on each fresh container,
# which will make any existing credentials permanently unreadable.
# Generate with: openssl rand -base64 24
N8N_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_24

# ─── Task Runner Auth ─────────────────────────────────────────
# A strong random secret shared between n8n-main and n8n-python-runner.
# Generate with: openssl rand -hex 32
N8N_RUNNERS_AUTH_TOKEN=CHANGE_ME_generate_a_strong_secret_here

# ─── PostgreSQL Database ─────────────────────────────────────
DB_TYPE=postgresdb
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_USER=n8n_user
DB_POSTGRESDB_PASSWORD=CHANGE_ME_strong_database_password

# ─── Logging ─────────────────────────────────────────────────
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console

# ─── Diagnostics (keep false to suppress startup timeouts) ───
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
